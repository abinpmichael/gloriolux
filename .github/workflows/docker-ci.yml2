name: Docker CI Pipeline

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  lint-and-build:
    runs-on: ubuntu-latest
    name: 🏗️ Lint & Build Docker Image

    steps:
      - name: 🚚 Checkout Repository
        uses: actions/checkout@v4

      - name: 🐘 Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          extensions: mbstring, xml, pdo, pdo_mysql, gd, zip

      - name: 🔍 PHP Syntax Check (Lint)
        run: |
          find . -name "*.php" ! -path "./vendor/*" -print0 | xargs -0 -n1 php -l

      - name: 🐳 Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: 📦 Build Docker Image
        uses: docker/build-push-action@v5
        with:
          context: .
          push: false # Do not push to a registry as per request to avoid "actual server deployment"
          tags: gloriolux:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: 🛡️ Scan Image for Vulnerabilities
        uses: docker/scout-action@v1
        with:
          command: quickview,cves
          image: gloriolux:latest
          only-severities: critical,high
          exit-code: true
