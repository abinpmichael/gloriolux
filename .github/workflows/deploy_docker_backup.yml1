name: Build, Test, and Deploy

on:
  push:
    branches:
      - main
      - master

jobs:
  build-and-test:
    name: 🧪 Build & Test
    runs-on: ubuntu-latest
    
    steps:
    - name: 🚚 Checkout code
      uses: actions/checkout@v4
      
    - name: 🐘 Setup PHP for Testing
      uses: shivammathur/setup-php@v2
      with:
        php-version: '8.2'
        
    - name: 🔍 Run Tests (PHP Syntax Check)
      run: |
        # This will scan all PHP files to ensure there are no syntax errors
        find . -name "*.php" ! -path "./vendor/*" -print0 | xargs -0 -n1 php -l

  deploy-to-live:
    name: 🚀 Deploy to Live Server (Docker Hub)
    needs: build-and-test
    runs-on: ubuntu-latest
    environment: production # 🛑 This creates the manual approval step in GitHub!
    
    steps:
    - name: 🚚 Checkout code
      uses: actions/checkout@v4
      
    - name: 🔑 Log in to Docker Hub
      uses: docker/login-action@v3
      with:
        username: ${{ secrets.DOCKER_USERNAME }}
        password: ${{ secrets.DOCKER_PASSWORD }}
        
    - name: 🏗️ Set up Docker Buildx
      uses: docker/setup-buildx-action@v3
      
    - name: 🐳 Build and push Docker image
      uses: docker/build-push-action@v5
      with:
        context: .
        push: true
        tags: ${{ secrets.DOCKER_USERNAME }}/gloriolux:latest
        cache-from: type=registry,ref=${{ secrets.DOCKER_USERNAME }}/gloriolux:buildcache
        cache-to: type=registry,ref=${{ secrets.DOCKER_USERNAME }}/gloriolux:buildcache,mode=max
