# =========================================================================
# GLORIOLUX - PROFESSIONAL .HTACCESS CONFIGURATION
# =========================================================================

# 1. SECURITY SETTINGS
# -------------------------------------------------------------------------
# Prevent directory listing (stops hackers from browsing folders)
Options -Indexes

# Block direct web access to sensitive server files
<FilesMatch "\.(log|sql|ini|env|md)$">
    Require all denied
</FilesMatch>

# 2. ERROR ROUTING
# -------------------------------------------------------------------------
# Route "Page Not Found" errors to the custom 404 page
ErrorDocument 404 /404.php

# 3. URL REWRITING (SEO FRIENDLY URLS)
# -------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS and WWW (Skip for localhost/XAMPP)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

    # 2. Redirect index.php to root (/)
    RewriteCond %{THE_REQUEST} ^.*/index\.php
    RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

    # 3. Remove .php extension (e.g. /about.php becomes /about)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# 4. PERFORMANCE & CACHING
# -------------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Enable GZIP compression to speed up the website
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    # Enable browser caching for faster return visits
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Security: Hide PHP errors from users on the live server (uncomment on live server)
# php_flag display_errors off
# php_value error_log /path/to/your/php_errors.log
