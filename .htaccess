ErrorDocument 404 /404.php

# =========================================================================
# REWRITE RULES (SIMPLIFIED - KEEP .PHP)
# =========================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # 0. Redirect sitemap.xml to sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 1. Force HTTPS and WWW
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect index.php to root ONLY
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    Options -MultiViews

    # 3. SEO-Friendly Blog URLs
    # Rewrite /blog/slug-name to blog_post.php?slug=slug-name
    RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog_post.php?slug=$1 [L,QSA,NC]

    # 4. Remove .php extension from all other pages
    # Redirect /page.php to /page (preserve query string)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Check if a .php file exists and rewrite (preserve query string)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [L,QSA]

    # 5. Browser Caching (Speed Optimization)
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresDefault "access plus 1 month"
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType text/css "access plus 1 month"
        ExpiresByType application/javascript "access plus 1 month"
    </IfModule>

    # 6. Gzip Compression (Significant Speed Boost)
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain
        AddOutputFilterByType DEFLATE text/html
        AddOutputFilterByType DEFLATE text/xml
        AddOutputFilterByType DEFLATE text/css
        AddOutputFilterByType DEFLATE application/xml
        AddOutputFilterByType DEFLATE application/xhtml+xml
        AddOutputFilterByType DEFLATE application/rss+xml
        AddOutputFilterByType DEFLATE application/javascript
        AddOutputFilterByType DEFLATE application/x-javascript
    </IfModule>
</IfModule>